{
  "permissions": {
    "allow": [
      "Bash(bash tools/check.sh*)",
      "Bash(bash tools/security.sh)",
      "Bash(bash tools/security.sh --due)",
      "Bash(bash tools/stories.sh --due)",
      "Bash(bash tools/prototype.sh *)",
      "Bash(bash tools/ui_capture.sh*)",
      "Bash(node tools/ui/drawing.mjs *)",
      "Bash(node tools/ui/overlay.mjs *)",
      "Bash(node tools/ui/verify.mjs *)",
      "Bash(node tools/ui/capture.mjs *)",
      "Bash(bash tools/setup-clone.sh*)",
      "Bash(bash tools/stacks/*.sh*)",
      "Bash(git add *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git rev-parse *)",
      "Bash(git commit *)",
      "Bash(git tag *)",
      "Bash(git stash *)",
      "Bash(git worktree *)",
      "Bash(git ls-files *)",
      "Bash(git grep *)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.local)",
      "Read(**/.env.local)",
      "Read(.env.*.local)",
      "Read(**/.env.*.local)",
      "Read(.env.development)",
      "Read(**/.env.development)",
      "Read(.env.production)",
      "Read(**/.env.production)",
      "Read(.env.staging)",
      "Read(**/.env.staging)",
      "Read(.env.test)",
      "Read(**/.env.test)",
      "Read(*.pem)",
      "Read(**/*.pem)",
      "Read(*.key)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.config/git/credentials)",
      "Read(~/.config/gh/**)",
      "Read(~/AppData/Roaming/GitHub CLI/**)",
      "Bash(git *--output*)",
      "PowerShell(git *--output*)",
      "Bash(git *--no-index*)",
      "PowerShell(git *--no-index*)",
      "Bash(git *--ext-diff*)",
      "PowerShell(git *--ext-diff*)",
      "Bash(git commit *--file*)",
      "PowerShell(git commit *--file*)",
      "Bash(git grep *--open*)",
      "PowerShell(git grep *--open*)",
      "Bash(git grep *-O*)",
      "PowerShell(git grep *-O*)",
      "Bash(git tag *--file*)",
      "PowerShell(git tag *--file*)",
      "Bash(bash tools/*..*)",
      "PowerShell(bash tools/*..*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/release-check.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/orphan-report.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.sh\"",
            "timeout": 3600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-commands.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-protected.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-protected.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-touched.sh\" before",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-touched.sh\" after",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-touched.sh\" after",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-touched.sh\" after",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
