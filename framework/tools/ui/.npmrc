# App Director screen capture · framework-owned: replaced on upgrade. No lock file, because the tree is fixed without one:
# playwright is pinned to one exact version and pins its only dependency, playwright-core, to the same version (which has
# none), so `npm install` gets the same packages every time. The Chromium that `npx playwright install chromium` downloads
# is tied to that version too. An upgrade of App Director moves the pin.
package-lock=false
